let employees=[];

let displayList=[];


// API CALL

function fetchEmployees(){


fetch("https://dummyjson.com/users")

.then(response=>response.json())

.then(data=>{


employees=data.users.map(user=>({

id:user.id,

name:user.firstName+" "+user.lastName,

age:user.age,

email:user.email,

phone:user.phone,

department:user.company.department,

image:user.image,

salary:Math.floor(Math.random()*50000)+30000


}));


displayList=[...employees];


displayEmployees(displayList);


document.getElementById("message").innerHTML=
"Employee data loaded successfully";


})


.catch(error=>{

document.getElementById("message").innerHTML=
"Unable to load employee data";

})


.finally(()=>{

console.log("API Completed");

});


}



fetchEmployees();




// DISPLAY EMPLOYEE


function displayEmployees(list){


let container=
document.getElementById("employeeContainer");


container.innerHTML="";


list.forEach(emp=>{


let card=document.createElement("div");

card.className="card";


card.innerHTML=`

<img src="${emp.image}">

<h3>${emp.name}</h3>

<p>Age: ${emp.age}</p>

<p>Email: ${emp.email}</p>

<p>Department: ${emp.department}</p>

<p>Phone: ${emp.phone}</p>

<p>Salary: ₹${emp.salary}</p>


<button onclick="deleteEmployee(${emp.id})">
Delete
</button>

`;

container.appendChild(card);


});


updateEmployeeCount(list);

calculateSalary(list);


}




// COUNT


function updateEmployeeCount(list){

document.getElementById("count").innerHTML=
"Employee Count: "+list.length;

}



// SEARCH


function searchEmployees(){


let value=
document.getElementById("searchInput").value
.toLowerCase();


let result=employees.filter(emp=>

emp.name.toLowerCase()
.includes(value)

);


displayEmployees(result);


}




// DEPARTMENT FILTER


function filterDepartment(dep){


let result;


if(dep==="All"){

result=employees;

}

else{


result=employees.filter(emp=>

emp.department.includes(dep)

);

}


displayEmployees(result);


}




// ADD EMPLOYEE


function addEmployee(){


let name=
document.getElementById("name").value;


let age=
Number(document.getElementById("age").value);


let email=
document.getElementById("email").value;


let department=
document.getElementById("department").value;



if(!validateEmployee(name,age,email,department))
return;



let newEmployee={


id:Date.now(),

name:name,

age:age,

email:email,

department:department,

phone:"N/A",

image:"https://dummyjson.com/icon/abc/128",

salary:50000


};



employees.push(newEmployee);



displayEmployees(employees);


clearForm();


}




// VALIDATION


function validateEmployee(name,age,email,department){


let error=document.getElementById("error");


if(name===""){

error.innerHTML=
"❌ Please enter employee name";

return false;

}



else if(age<=18){

error.innerHTML=
"❌ Age must be above 18";

return false;

}


else if(email===""){

error.innerHTML=
"❌ Enter email";

return false;

}


else if(department===""){

error.innerHTML=
"❌ Select department";

return false;

}


error.innerHTML="";

return true;


}





// DELETE


function deleteEmployee(id){


employees=
employees.filter(emp=>emp.id!==id);


displayEmployees(employees);


}




// SALARY


function calculateSalary(list){


let total=list.reduce((sum,emp)=>

sum+emp.salary,0);



let average=
Math.floor(total/list.length);



let highest=
list.reduce((a,b)=>

a.salary>b.salary?a:b);



document.getElementById("salaryDetails").innerHTML=

`

<h3>Total Salary: ₹${total}</h3>

<h3>Average Salary: ₹${average}</h3>

<h3>Highest Paid Employee:
${highest.name}
₹${highest.salary}</h3>

`;

}



// SORT


function sortEmployees(type){


if(type==="name"){


employees.sort((a,b)=>

a.name.localeCompare(b.name));

}


else if(type==="age"){


employees.sort((a,b)=>

a.age-b.age);

}


else if(type==="salary"){


employees.sort((a,b)=>

b.salary-a.salary);

}



displayEmployees(employees);


}




